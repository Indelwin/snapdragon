{
  "name": "snapdragon-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/host",
    "packages/ui",
    "packages/gateway",
    "packages/content",
    "packages/session",
    "packages/config",
    "packages/tools",
    "packages/checkpoint",
    "packages/agent",
    "packages/learn",
    "packages/sd",
    "packages/repl",
    "examples/basic-agent",
    "examples/coding-repl"
  ],
  "scripts": {
    "build": "npm run build:wasm && npm run build --workspaces --if-present",
    "build:wasm": "bash scripts/build-wasm.sh",
    "changeset": "changeset",
    "check": "npm run check:push",
    "check:deep": "npm run check:push && npm run quality:coupling -- --verbose && npm run quality:risk -- --verbose && npm run mutation:js && npm run mutation:rust",
    "check:fast": "npm run lint && npm run spec:lint && npm run quality:maintainability && npm run quality:baseline && npm run quality:architecture",
    "check:push": "npm run check:fast && npm run typecheck && npm run test:quality && npm run test:js:coverage && npm run quality:crap && npm run quality:reports && npm run test:rust",
    "clean": "npm run clean --workspaces --if-present && rm -rf target",
    "format": "biome check --write . && cargo fmt --all",
    "lint": "biome check . && cargo fmt --all --check",
    "mutation:js": "stryker run",
    "mutation:rust": "bash scripts/quality/mutation-rust.sh",
    "pack:dry": "npm pack --workspace @snapdragon-ai/core --workspace @snapdragon-ai/host --workspace @snapdragon-ai/ui --workspace @snapdragon-ai/gateway --workspace @snapdragon-ai/content --workspace @snapdragon-ai/session --workspace @snapdragon-ai/config --workspace @snapdragon-ai/tools --workspace @snapdragon-ai/agent --workspace @snapdragon-ai/learn --workspace @snapdragon-ai/sd --workspace @snapdragon-ai/repl --dry-run",
    "prepare": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit .githooks/pre-push scripts/quality/*.sh scripts/quality/*.mjs",
    "quality:architecture": "node scripts/quality/architecture-analysis.mjs",
    "quality:baseline": "node scripts/quality/baseline-guard.mjs",
    "quality:coupling": "node scripts/quality/coupling-report.mjs",
    "quality:crap": "node scripts/quality/crap-analysis.mjs",
    "quality:maintainability": "node scripts/quality/maintainability-analysis.mjs",
    "quality:reports": "npm run quality:coupling -- --summary && npm run quality:risk -- --summary",
    "quality:risk": "node scripts/quality/risk-report.mjs",
    "spec:lint": "node scripts/quality/check-gherkin.mjs",
    "test": "npm run test:js && npm run test:rust",
    "test:js": "npm run test --workspaces --if-present",
    "test:js:coverage": "node scripts/quality/test-js-coverage.mjs",
    "test:quality": "node --test scripts/quality/test/*.test.mjs",
    "test:rust": "cargo test --workspace -- --test-threads=1",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "npm run build && changeset publish",
    "publish:dry": "npm run pack:dry"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@changesets/cli": "^2.31.0",
    "@cucumber/gherkin": "39.0.0",
    "@cucumber/messages": "32.3.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@types/node": "^22.10.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
