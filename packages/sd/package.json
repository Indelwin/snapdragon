{
  "name": "@snapdragon-ai/sd",
  "version": "0.2.0",
  "description": "Batteries-included Snapdragon code agent CLI.",
  "type": "module",
  "bin": {
    "sd": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "import": "./dist/tui/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bundleDependencies": [
    "ink"
  ],
  "scripts": {
    "prepack": "npm run build --workspace @snapdragon-ai/ink && node ../../scripts/pack-renderer.mjs",
    "postpack": "node ../../scripts/pack-renderer.mjs --clean",
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json && cp -R src/first-party dist/first-party && chmod +x dist/cli.js && node ../../scripts/build-info.mjs",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "typecheck": "tsc -b tsconfig.build.json --pretty false",
    "test": "node --test --import tsx test/*.test.ts",
    "test:reliability:tui": "node ../../scripts/reliability/run.mjs"
  },
  "dependencies": {
    "@snapdragon-ai/agent": "0.2.0",
    "@snapdragon-ai/config": "0.2.0",
    "@snapdragon-ai/content": "0.2.0",
    "@snapdragon-ai/gateway": "0.2.0",
    "@snapdragon-ai/host": "0.2.0",
    "@snapdragon-ai/session": "0.2.0",
    "@snapdragon-ai/tools": "0.2.0",
    "@snapdragon-ai/webtools": "0.2.0",
    "@snapdragon-ai/ui": "0.2.0",
    "@types/figlet": "^1.7.0",
    "dotenv": "^17.2.3",
    "figlet": "^1.11.0",
    "ink": "npm:@snapdragon-ai/ink@7.0.2",
    "react": "^19.2.5",
    "react-devtools-core": "^6.1.2",
    "sharp": "^0.34.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.3"
  },
  "license": "MIT"
}
