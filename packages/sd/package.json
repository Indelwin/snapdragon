{
  "name": "@snapdragon-ai/sd",
  "version": "0.1.1",
  "description": "Batteries-included Snapdragon code agent CLI.",
  "type": "module",
  "bin": {
    "sd": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "import": "./dist/tui/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -R src/first-party dist/first-party && chmod +x dist/cli.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc -b tsconfig.build.json --pretty false",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@snapdragon-ai/agent": "0.1.1",
    "@snapdragon-ai/config": "0.1.1",
    "@snapdragon-ai/content": "0.1.1",
    "@snapdragon-ai/host": "0.1.1",
    "@snapdragon-ai/session": "0.1.1",
    "@snapdragon-ai/tools": "0.1.1",
    "@snapdragon-ai/ui": "0.1.1",
    "dotenv": "^17.2.3",
    "ink": "^7.0.1",
    "react": "^19.2.5",
    "react-devtools-core": "^6.1.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.3"
  },
  "license": "MIT"
}
