{
  "name": "@snapdragon-ai/checkpoint",
  "version": "0.1.0",
  "description": "Filesystem checkpoints for agent tool calls — shadow git repos, fail-quiet, undoable.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc -b tsconfig.build.json --pretty false"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  },
  "license": "MIT"
}
