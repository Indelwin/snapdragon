{
  "name": "@snapdragon-ai/repl",
  "version": "0.1.0",
  "description": "Minimal Snapdragon coding REPL agent CLI.",
  "type": "module",
  "bin": {
    "snapdragon": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc -b tsconfig.build.json --pretty false"
  },
  "dependencies": {
    "@snapdragon-ai/agent": "0.1.0",
    "@snapdragon-ai/host": "0.1.0"
  },
  "license": "MIT"
}
