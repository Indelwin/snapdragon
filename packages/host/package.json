{
  "name": "@snapdragon-ai/host",
  "version": "0.1.1",
  "description": "Host runtime primitives and provider adapters for Snapdragon agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/mock": {
      "types": "./dist/providers/mock.d.ts",
      "import": "./dist/providers/mock.js"
    },
    "./providers/openai": {
      "types": "./dist/providers/openai.d.ts",
      "import": "./dist/providers/openai.js"
    },
    "./providers/openai-compatible": {
      "types": "./dist/providers/openai-compatible.d.ts",
      "import": "./dist/providers/openai-compatible.js"
    },
    "./providers/openai-responses": {
      "types": "./dist/providers/openai-responses.d.ts",
      "import": "./dist/providers/openai-responses.js"
    },
    "./providers/codex": {
      "types": "./dist/providers/codex.d.ts",
      "import": "./dist/providers/codex.js"
    },
    "./providers/codex-auth": {
      "types": "./dist/providers/codex-auth.d.ts",
      "import": "./dist/providers/codex-auth.js"
    },
    "./providers/codex-auth-store": {
      "types": "./dist/providers/codex-auth-store.d.ts",
      "import": "./dist/providers/codex-auth-store.js"
    },
    "./providers/anthropic": {
      "types": "./dist/providers/anthropic.d.ts",
      "import": "./dist/providers/anthropic.js"
    },
    "./model-discovery": {
      "types": "./dist/model-discovery.d.ts",
      "import": "./dist/model-discovery.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc -b tsconfig.build.json --pretty false"
  },
  "dependencies": {
    "@snapdragon-ai/core": "0.1.1"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  },
  "license": "MIT"
}
