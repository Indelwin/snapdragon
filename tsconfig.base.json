{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@snapdragon-ai/core": ["packages/core/src/index.ts"],
      "@snapdragon-ai/host": ["packages/host/src/index.ts"],
      "@snapdragon-ai/host/*": ["packages/host/src/*"],
      "@snapdragon-ai/ui": ["packages/ui/src/index.ts"],
      "@snapdragon-ai/content": ["packages/content/src/index.ts"],
      "@snapdragon-ai/session": ["packages/session/src/index.ts"],
      "@snapdragon-ai/config": ["packages/config/src/index.ts"],
      "@snapdragon-ai/tools": ["packages/tools/src/index.ts"],
      "@snapdragon-ai/tools/*": ["packages/tools/src/*"],
      "@snapdragon-ai/webtools": ["packages/webtools/src/index.ts"],
      "@snapdragon-ai/webtools/*": ["packages/webtools/src/*"],
      "@snapdragon-ai/checkpoint": ["packages/checkpoint/src/index.ts"],
      "@snapdragon-ai/agent": ["packages/agent/src/index.ts"],
      "@snapdragon-ai/sd": ["packages/sd/src/index.ts"],
      "@snapdragon-ai/repl": ["packages/repl/src/index.ts"]
    }
  }
}
